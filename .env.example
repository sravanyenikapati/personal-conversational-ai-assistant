# ──────────────────────────────────────────────────────────────────────────────
# Personal AI Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── AI Provider (choose one, or both) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key-here...
ANTHROPIC_API_KEY=sk-ant-...your-claude-key-here...   # Phase 2

# ── Active AI Provider: "openai" or "anthropic" ───────────────────────────────
AI_PROVIDER=openai

# ── Model Selection ───────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Voice / Audio ─────────────────────────────────────────────────────────────
# Edge TTS voice — free, no key needed. Examples:
#   en-US-AriaNeural  (female, natural)
#   en-US-GuyNeural   (male, natural)
#   en-GB-SoniaNeural (British female)
TTS_VOICE=en-US-AriaNeural

# STT: "whisper-api" (uses OpenAI, needs key) or "whisper-local" (runs offline)
STT_ENGINE=whisper-api
WHISPER_MODEL=whisper-1

# ── App Settings ──────────────────────────────────────────────────────────────
APP_NAME=Personal AI Assistant
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
MAX_CONVERSATION_HISTORY=20      # Messages to keep in memory
