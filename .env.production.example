# ── Production Environment Variables ─────────────────────────────────────────
# Copy this to .env on your server / Railway / Render environment.
# NEVER commit real keys to git.

# ── AI Provider ───────────────────────────────────────────────────────────────
AI_PROVIDER=openai                          # openai | anthropic
OPENAI_API_KEY=sk-...your-key-here...
ANTHROPIC_API_KEY=sk-ant-...your-key...     # optional if using openai

# ── Models ────────────────────────────────────────────────────────────────────
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── TTS / STT ─────────────────────────────────────────────────────────────────
TTS_VOICE=en-US-AriaNeural
STT_ENGINE=whisper-api
WHISPER_MODEL=whisper-1

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Personal AI Assistant
LOG_LEVEL=INFO
MAX_CONVERSATION_HISTORY=20

# ── Storage ───────────────────────────────────────────────────────────────────
# Override where custom agents JSON is saved (useful in containers)
# CUSTOM_AGENTS_DIR=/data
